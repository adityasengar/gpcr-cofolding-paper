# Heavy and reconstructible — never travels between machines.
# NOTE: comments must be on their own line; git does not strip trailing comments.

# 452M, re-downloadable from the DOIs in lit/refs.bib
lit/pdfs/
# 458M, the original download folder (hard links to the same PDFs)
lit/source/
# regenerable with pdftotext / tesseract
lit/validate/txt/
lit/validate/txt2/
lit/validate/pages/
lit/ocr/
# 19M HPC export, not authored here
# 7M, large but the primary local data table — keep? see SESSIONS.md decision
# data/predictions.csv

# overleaf/ is a separate clone of the Overleaf project, used only as an
# export target for sharing. Optional, and only where you publish from.
overleaf/

# build + local noise
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdf
!GPCR_progress_summary.pdf
.DS_Store
**/.DS_Store
*.pyc
__pycache__/

# per-machine identity; never shared
.machine

# advisory lock for same-laptop sessions; per-machine, never shared
.session-lock

# figures: the scripts are durable, their output is not
figures/out/
figures/structures/

# Block A data drop: tabular data is committed (every number must trace to a
# shipped file); coordinates and the original zip are not, per lit/pdfs precedent
block_a_figure_data.zip
data/block_a/11_structures/

# Block B drop, same rule as Block A: tabular data is committed so every number
# traces to a shipped file; coordinates and the original zips are not.
block_b_figure_data.zip
block_b_structures.zip
data/block_b_structures/**/*.cif

# Block C drop, same rule as A and B
block_c_figure_data.zip
block_c_structures.zip
data/block_c/13_structures/**/*.cif

# Block D, landed 2026-09-10. Coordinates excluded like every other block's:
# 4.4 MB, and every number we take from them is recorded in
# analysis/block_d/tables/D-T1_structures_measured.csv and
# analysis/block_d/cif_measurements.json, both of which ARE committed. The
# manifest is committed too, so the files can be re-pulled and re-measured.
block_d_figure_data.zip
data/block_d/10_structures/**/*.cif

# scrape artefact, 2026-09-11
gpdb_coup.html
# Group 0 mmCIF cache, regenerable, 1-3 GB
redo/cache/structures/

# the /loop scheduler's own state, not project content
.claude/scheduled_tasks.lock

# rows.tier3.v2.csv — 92 MB, arrived 2026-09-12, the file Block C pinned 18 times
# and never shipped. Excluded by size per the lit/pdfs and block_a/11_structures
# precedent; its sha256 is committed in the README beside it, so provenance
# survives the exclusion.
analysis/block_c/received_2026_09_12/*.csv
# Block D's three row tables, 92.8 MB, landed by hand 2026-09-13.
# Same rule as rows.tier3.v2.csv: too large for git, hashes are the record.
analysis/block_d/received_2026_09_13/*.csv
