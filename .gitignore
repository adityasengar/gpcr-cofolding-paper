# Heavy and reconstructible — never travels between machines.
# NOTE: comments must be on their own line; git does not strip trailing comments.

# 452M, re-downloadable from the DOIs in lit/refs.bib
lit/pdfs/
# 458M, the original download folder (hard links to the same PDFs)
lit/source/
# regenerable with pdftotext / tesseract
lit/validate/txt/
lit/validate/txt2/
lit/validate/pages/
lit/ocr/
# 19M HPC export, not authored here
# 7M, large but the primary local data table — keep? see SESSIONS.md decision
# data/predictions.csv

# overleaf/ is a separate clone of the Overleaf project, used only as an
# export target for sharing. Optional, and only where you publish from.
overleaf/

# build + local noise
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdf
!GPCR_progress_summary.pdf
.DS_Store
**/.DS_Store
*.pyc
__pycache__/

# per-machine identity; never shared
.machine

# advisory lock for same-laptop sessions; per-machine, never shared
.session-lock

# figures: the scripts are durable, their output is not
figures/out/
figures/structures/

# Block A data drop: tabular data is committed (every number must trace to a
# shipped file); coordinates and the original zip are not, per lit/pdfs precedent
block_a_figure_data.zip
data/block_a/11_structures/
